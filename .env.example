# Process-as-Code reference lab. Create .env with: scripts/init-env.sh
# Values marked __GENERATE__ are replaced with random secrets by that script.

# ── Addressing ─────────────────────────────────────────────────────────
# Every service gets a subdomain: auth.<domain>, processgit.<domain>, …
# *.localhost resolves to this machine in current browsers.
LAB_DOMAIN=lab.localhost
LAB_SCHEME=http

# ── LLM gateway (any OpenAI-compatible endpoint, without the /v1 suffix) ─
LLM_GATEWAY_URL=http://host.docker.internal:8000
LLM_API_KEY=
LLM_MODEL=

# ── Identity (Keycloak) ────────────────────────────────────────────────
KC_ADMIN_USER=labadmin
KC_ADMIN_PASSWORD=__GENERATE__
KC_DB_PASSWORD=__GENERATE__
OIDC_CLIENT_SECRET=__GENERATE__
OIDC_CRYPTO_PASSPHRASE=__GENERATE__

# ── Core ───────────────────────────────────────────────────────────────
PROCESSGIT_SECRET_KEY=__GENERATE__
PROCESSGIT_INTERNAL_TOKEN=__GENERATE__
AGENT_API_TOKEN=__GENERATE__
EVENT_SIGNER_SECRET_KEY=__GENERATE_HEX32__

# ── Profile "dms" (OpenDMS) ────────────────────────────────────────────
DMS_DB_PASSWORD=__GENERATE__
DMS_JWT_SECRET=__GENERATE__
DMS_MCP_NODE_TOKEN=__GENERATE__
DMS_SUPERADMIN_EMAIL=admin@example.org
DMS_SUPERADMIN_PASSWORD=__GENERATE__

# ── Profile "legal" (OpenLegal) ────────────────────────────────────────
LEGAL_DB_PASSWORD=__GENERATE__
ELIGUMI_API_KEY=__GENERATE__

# ── Profile "studio" (Studio) ──────────────────────────────────────────
STUDIO_DB_PASSWORD=__GENERATE__
STUDIO_REDIS_PASSWORD=__GENERATE__
STUDIO_SESSION_SECRET=__GENERATE__

# ── Web application firewall (OWASP CRS): DetectionOnly logs, On blocks ─
LAB_WAF_MODE=DetectionOnly
